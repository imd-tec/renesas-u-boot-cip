/*
 * Shared default environment for the IMDT V2H / V2N SBCs.
 *
 * Each board's own .env sets fdtfile and serial#, then includes this file.
 *
 * Kernel and device trees live in /boot on partition 2 of either the SD card
 * (mmc 1) or the eMMC (mmc 0). Linux enumerates the two controllers in the
 * same order U-Boot does, so mmcdev doubles as the mmcblk index in root=.
 */

usb_pgood_delay=2000
bootm_size=0x10000000

kernel_addr=0x48080000
fdt_addr=0x48000000
mmcpart=2

load_kernel=ext4load mmc ${mmcdev}:${mmcpart} ${kernel_addr} boot/Image &&
	ext4load mmc ${mmcdev}:${mmcpart} ${fdt_addr} boot/${fdtfile}

/* Overlays in /boot, applied in order; literal, as hush keeps Kconfig quotes. */
overlay_addr=0x58000000
overlay_list=imdt-v2-sbc-dsi-panel.dtbo

/* Without the resize, fdt apply fails with FDT_ERR_NOSPACE. */
apply_overlays=
	if test -n "${overlay_list}"; then
		fdt addr ${fdt_addr};
		fdt resize 0x20000;
		for overlay in ${overlay_list}; do
			run apply_one_overlay;
		done;
	fi

/* A missing or unappliable overlay warns and boots on. */
apply_one_overlay=
	if ext4load mmc ${mmcdev}:${mmcpart} ${overlay_addr} boot/${overlay}; then
		fdt apply ${overlay_addr} && echo Applied overlay ${overlay};
	else
		echo WARNING: overlay ${overlay} not found in boot/;
	fi

mmcboot=setenv bootargs rw rootwait earlycon root=/dev/mmcblk${mmcdev}p${mmcpart};
	if run load_kernel; then
		run apply_overlays;
		booti ${kernel_addr} - ${fdt_addr};
	fi

sdboot=setenv mmcdev 1; run mmcboot
emmcboot=setenv mmcdev 0; run mmcboot

/* SD first, so a card can override the image installed on eMMC. */
bootcmd=run sdboot; run emmcboot; echo No bootable kernel found
